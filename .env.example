# Gmail ↔ Telegram bridge — copy to .env (never commit real secrets)
AGENT_PORT=8765
POLL_INTERVAL_SECONDS=30

# Google Cloud OAuth 2.0 (APIs & Services → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth2callback
GCP_QUOTA_PROJECT=
SARABYX_GMAIL_ADDRESS=

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Optional: Gemini for natural-language chat / summaries
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
